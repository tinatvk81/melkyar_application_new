POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=realestate
POSTGRES_USER=realestate_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=480

SERVER_BIND_HOST=0.0.0.0
SERVER_PORT=8000

# در محیط عملیاتی همیشه false بماند. فقط برای توسعه‌ی محلی روی true بگذارید
# تا مستندات خودکار API در /docs و /redoc دوباره در دسترس باشند.
DEBUG=false

APP_VERSION=1.0.0
INSTALLER_FILENAME=RealEstateApp-Setup-1.0.0.exe

# --- یادآوری پیامکی (اختیاری) ---
# پیش‌فرض خاموش. برای فعال‌سازی، یک حساب نزد یک سرویس‌دهنده‌ی پیامک ایرانی
# (مثلاً کاوه‌نگار: https://kavenegar.com) بسازید و کلید API را این‌جا بگذارید.
SMS_ENABLED=false
SMS_API_KEY=
SMS_SENDER_LINE=
SMS_URGENT_DAYS_THRESHOLD=3
